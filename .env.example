# Google AI Studio (Gemini) credentials for ADK.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-api-key-here

# Path to the SQLite session store used for persistent memory (optional).
SOUS_SESSION_DB=sqlite:///./sous_sessions.sqlite

# Conversation-history compaction: number of recent turns the coordinator keeps
# verbatim before each model call (older turns are trimmed/summarised). Optional.
SOUS_HISTORY_WINDOW=12

# Long-term memory backend (optional). Defaults to an in-memory keyword store.
# Set to "vertex" to use the managed Vertex AI Memory Bank (semantic recall of
# facts across sessions); then supply the Vertex settings below.
SOUS_MEMORY_BACKEND=
SOUS_VERTEX_PROJECT=
SOUS_VERTEX_LOCATION=us-central1
SOUS_VERTEX_AGENT_ENGINE_ID=
