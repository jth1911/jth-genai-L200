# Google AI Studio (Gemini) credentials for ADK.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-api-key-here

# Strategic model routing (optional). Agents are routed across two tiers by task
# complexity: FAST for simple specialists/rendering, SMART for the reasoning-heavy
# planning steps and the coordinator. Override either tier here; SOUS_MODEL is a
# back-compat single knob that pins both tiers to one model.
SOUS_FAST_MODEL=gemini-3.6-flash
SOUS_SMART_MODEL=gemini-pro-latest
# SOUS_MODEL=gemini-3.6-flash

# Observability (optional). Log level for the structured JSON logs.
SOUS_LOG_LEVEL=INFO
# ADK captures message content (incl. tool args like weight/allergens/pantry) in
# span attributes by default; the app defaults this to "false" so PII stays out of
# traces. Set to "true" to opt back in to full-content spans.
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# Path to the SQLite session store used for persistent memory (optional).
SOUS_SESSION_DB=sqlite:///./sous_sessions.sqlite

# Conversation-history compaction: number of recent turns the coordinator keeps
# verbatim before each model call (older turns are trimmed/summarised). Optional.
SOUS_HISTORY_WINDOW=12

# Long-term memory backend (optional). Defaults to an in-memory keyword store.
# Set to "vertex" to use the managed Vertex AI Memory Bank (semantic recall of
# facts across sessions); then supply the Vertex settings below.
SOUS_MEMORY_BACKEND=
SOUS_VERTEX_PROJECT=
SOUS_VERTEX_LOCATION=us-central1
SOUS_VERTEX_AGENT_ENGINE_ID=
